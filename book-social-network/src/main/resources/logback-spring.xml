<configuration>

    <property name="LOG_PATH" value="logs"/>

    <!-- Console format -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} | %highlight(%-5level) | %cyan(%thread) | %blue(%logger{40}) | %green(%msg) | %magenta(reqId) = %X{requestId:-} | %magenta(actor) = %X{actorType:-}:%X{actorCode:-} | %magenta(details) { %kvp }%n"/>

    <!-- Console -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- JSON File -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/application.log</file>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

            <providers>

                <timestamp/>

                <logLevel/>

                <loggerName/>

                <threadName/>

                <message/>

                <mdc/>

                <keyValuePairs/>

                <stackTrace/>

            </providers>

        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/application.%d{yyyy-MM-dd}.log.gz
            </fileNamePattern>

            <maxHistory>30</maxHistory>

            <totalSizeCap>5GB</totalSizeCap>

        </rollingPolicy>

    </appender>


    <!-- Logger overrides -->
    <logger name="ExceptionLogger" level="DEBUG"/>


    <!-- Root -->
    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="FILE"/>

    </root>

</configuration>